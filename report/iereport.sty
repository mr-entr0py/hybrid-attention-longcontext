% iereport.sty -- house style for the IE624 pre-project report.
% Modelled on the NeurIPS conference layout: a single 5.5-inch text column, a Times-family
% text face, unadorned bold headings, block paragraphs and quiet floats.
%
% Typeface: STIX Two Text with STIX Two Math. STIX Two is a modern Times-family design made for
% scientific publishing, and its math face was drawn to match the text face, so prose and
% equations share one design. Diagram labels use TeX Gyre Heros (a Helvetica-family sans) and
% code uses Inconsolata.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{iereport}[2026/11/14 IE624 report style]

% ---------------------------------------------------------------- page geometry (NeurIPS-like)
\RequirePackage[a4paper,textwidth=5.5in,textheight=9.2in,top=1.05in,footskip=0.45in,headheight=12pt]{geometry}

% ---------------------------------------------------------------- fonts
\RequirePackage{fontspec}
\RequirePackage[warnings-off={mathtools-colon,mathtools-overbracket}]{unicode-math}
\setmainfont{STIXTwoText}[Extension=.otf,UprightFont=*-Regular,ItalicFont=*-Italic,
  BoldFont=*-Bold,BoldItalicFont=*-BoldItalic]
\setsansfont{texgyreheros}[Extension=.otf,UprightFont=*-regular,ItalicFont=*-italic,
  BoldFont=*-bold,BoldItalicFont=*-bolditalic,Scale=MatchLowercase]
\setmonofont{Inconsolatazi4}[Extension=.otf,UprightFont=*-Regular,BoldFont=*-Bold,Scale=MatchLowercase]
\setmathfont{STIXTwoMath-Regular.otf}
\RequirePackage[protrusion=true]{microtype}
\newcommand{\lnum}{}  % STIX Two uses lining figures throughout

% ---------------------------------------------------------------- colour (used sparingly)
\RequirePackage{xcolor}
\definecolor{ink}{HTML}{000000}
\definecolor{ink2}{HTML}{4D4D4D}
\definecolor{rule}{HTML}{000000}
\definecolor{linkblue}{HTML}{1F3F7A}
\definecolor{fullc}{HTML}{1C5CAB}     % full-attention layers (data encoding only)
\definecolor{linc}{HTML}{C9DDF6}      % linear layers (data encoding only)
\definecolor{fillg}{HTML}{F2F2F2}
\definecolor{done}{HTML}{3A3A3A}
\definecolor{wip}{HTML}{B8B8B8}
\definecolor{todo}{HTML}{FFFFFF}

% ---------------------------------------------------------------- headings (NeurIPS style)
\RequirePackage{titlesec}
\titleformat{\section}{\normalfont\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection}{1em}{}
\titlespacing*{\section}{0pt}{2.6ex plus 0.8ex minus .3ex}{1.3ex plus .2ex}
\titlespacing*{\subsection}{0pt}{2.0ex plus 0.6ex minus .3ex}{1.0ex plus .2ex}
\titleformat{\paragraph}[runin]{\normalfont\normalsize\bfseries}{}{0pt}{}
\titlespacing*{\paragraph}{0pt}{1.0ex plus 0.4ex minus .2ex}{1em}

% ---------------------------------------------------------------- page style: number only
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\thepage}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[C]{\thepage}}

% ---------------------------------------------------------------- body text (block paragraphs)
\setlength{\parindent}{0pt}
\setlength{\parskip}{5.5pt plus 1pt}
\clubpenalty=3000 \widowpenalty=3000 \displaywidowpenalty=1500
\raggedbottom
\frenchspacing
\setlength{\emergencystretch}{1.5em}

% ---------------------------------------------------------------- maths
\RequirePackage{mathtools}
\newcommand{\R}{\mathbb{R}}
\newcommand{\vect}[1]{\symbf{#1}}
\newcommand{\T}{\mathsf{T}}
\DeclareMathOperator{\softmax}{softmax}
\newcommand{\Full}{\mathsf{F}}
\newcommand{\Lin}{\symup{\Lambda}}

% ---------------------------------------------------------------- floats and captions
\RequirePackage{graphicx}
\RequirePackage{booktabs,tabularx,multirow,array}
\RequirePackage[font=small,labelsep=colon,justification=justified,singlelinecheck=true,skip=6pt]{caption}
\captionsetup[table]{position=top,skip=4pt}
\renewcommand{\arraystretch}{1.1}
\setlength{\tabcolsep}{5pt}
\setlength{\textfloatsep}{14pt plus 2pt minus 4pt}
\setlength{\floatsep}{12pt plus 2pt minus 2pt}
\setlength{\intextsep}{12pt plus 2pt minus 2pt}
\renewcommand{\topfraction}{0.9}
\renewcommand{\bottomfraction}{0.7}
\renewcommand{\textfraction}{0.08}
\renewcommand{\floatpagefraction}{0.8}

% ---------------------------------------------------------------- diagrams (flat, thin, greyscale)
\RequirePackage{tikz}
\usetikzlibrary{positioning,arrows.meta,calc,fit,backgrounds,shapes.misc,decorations.pathreplacing}
\tikzset{
  >={Latex[length=1.8mm,width=1.3mm]},
  box/.style={draw=black!70,rounded corners=0.6pt,line width=0.45pt,fill=white,align=center,
              font=\footnotesize,inner sep=2.5pt},
  lab/.style={font=\scriptsize,text=ink2,align=center},
}

% ---------------------------------------------------------------- lists
\RequirePackage{enumitem}
\setlist{itemsep=1pt,topsep=2pt,parsep=0pt,leftmargin=1.4em}

% ---------------------------------------------------------------- references
\RequirePackage[round,authoryear,sort]{natbib}
\setlength{\bibsep}{2pt plus 0.5pt}
\renewcommand{\bibfont}{\small\raggedright}
\RequirePackage[hidelinks,unicode,pdfusetitle]{hyperref}
\hypersetup{colorlinks=true,linkcolor=linkblue,citecolor=linkblue,urlcolor=linkblue}
\RequirePackage[nameinlink,capitalise,noabbrev]{cleveref}
\crefname{equation}{Eq.}{Eqs.}
\Crefname{equation}{Eq.}{Eqs.}
\urlstyle{same}

% ---------------------------------------------------------------- small helpers
\newcommand{\code}[1]{\texttt{#1}}
\newcommand{\tablefont}{\small}

\endinput
